# Step 1: Pull the dedicated OGC kernel & module caching image layer
FROM ghcr.io/ublue-os/akmods-ogc:main-fedora-44 AS kernel-source

# Step 2: Target your pristine, desktop-less deployment base image 
FROM ghcr.io/ublue-os/base-main:latest

# Step 3: Copy the RPM files from the standard /kernel-rpms location
COPY --from=kernel-source /kernel-rpms/ /tmp/kernel-rpms/

# Step 4: Perform the transaction replacement layer against standard Fedora core packages
RUN rpm-ostree override replace \
    /tmp/kernel-rpms/kernel-[0-9]*.rpm \
    /tmp/kernel-rpms/kernel-core-*.rpm \
    /tmp/kernel-rpms/kernel-modules-*.rpm \
    /tmp/kernel-rpms/kernel-modules-core-*.rpm \
    /tmp/kernel-rpms/kernel-modules-extra-*.rpm && \
    ostree container commit
