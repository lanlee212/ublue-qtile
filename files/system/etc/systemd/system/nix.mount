[Unit]
Description=Nix store bind mount (/var/nix onto /nix)
# bootc mounts the root read-only; /var is writable. Nix refuses a
# symlinked /nix, so /nix is a real (empty) dir in the image and
# /var/nix is bind-mounted over it at boot.

[Mount]
What=/var/nix
Where=/nix
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
