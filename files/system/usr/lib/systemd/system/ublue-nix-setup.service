[Unit]
Description=Install Nix (Determinate installer, first boot)
ConditionPathExists=!/etc/.ublue-nix-setup
After=network-online.target nix.mount
Wants=network-online.target nix.mount

[Service]
Type=oneshot
ExecStart=/usr/libexec/ublue-nix-setup.sh
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
